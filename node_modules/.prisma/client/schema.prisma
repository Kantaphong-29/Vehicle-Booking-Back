generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==========================
// ผู้ใช้งานระบบ (อาจารย์/บุคลากร, ผู้ควบคุมหน่วยยานพาหนะ, ผู้ดูแลระบบ)
// ==========================
enum Role {
  USER // อาจารย์ / บุคลากรผู้ขอใช้รถ
  STAFF // ผู้ควบคุมหน่วยยานพาหนะ / เจ้าหน้าที่
  ADMIN // ผู้ดูแลระบบ
}

model User {
  id         Int      @id @default(autoincrement())
  name       String
  email      String   @unique
  password   String
  phone      String?
  department String? // ภาควิชา/สาขาวิชา/หน่วยงาน
  role       Role     @default(USER)
  avatarUrl  String?  @db.Text // เก็บเป็น base64 data URL ของรูปโปรไฟล์
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  bookings Booking[] @relation("RequesterBookings")

  @@map("users")
}

// ==========================
// รถตู้
// ==========================
enum VehicleStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
}

model Vehicle {
  id          Int           @id @default(autoincrement())
  plateNumber String        @unique
  brand       String?
  model       String?
  seats       Int?
  status      VehicleStatus @default(AVAILABLE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  bookings Booking[]

  @@map("vehicles")
}

// ==========================
// พนักงานขับรถ
// ==========================
enum DriverStatus {
  AVAILABLE
  ON_DUTY
  OFF
}

model Driver {
  id        Int          @id @default(autoincrement())
  name      String
  phone     String
  status    DriverStatus @default(AVAILABLE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  bookings Booking[]

  @@map("drivers")
}

// ==========================
// คำขอใช้รถ (การจอง)
// ==========================
enum BookingPurpose {
  SUPERVISION // นิเทศนักศึกษาฝึกประสบการณ์วิชาชีพครู/สอบสอน
  MEETING // ประชุม/อบรม/สัมมนา
  PICKUP_SPEAKER // รับ-ส่งอาจารย์พิเศษหรือวิทยากร
  STUDY_VISIT // นำนักศึกษาไปศึกษาดูงาน
  OTHER // อื่น ๆ
}

enum TripType {
  ROUND_TRIP // ไป-กลับ
  ONE_WAY // เที่ยวเดียว
}

enum BookingStatus {
  PENDING // รออนุมัติ
  APPROVED // อนุมัติแล้ว
  REJECTED // ปฏิเสธ
  COMPLETED // เดินทางเสร็จสิ้น
  CANCELLED // ยกเลิกโดยผู้ขอ
}

model Booking {
  id Int @id @default(autoincrement())

  requester   User @relation("RequesterBookings", fields: [requesterId], references: [id])
  requesterId Int

  purpose       BookingPurpose
  purposeDetail String? // รายละเอียดเพิ่มเติม กรณีเลือก OTHER

  destination    String // สถานที่ไปราชการ
  street         String? // ถนน
  province       String? // จังหวัด
  route          String? // เส้นทางที่ขอให้รถผ่าน
  startDateTime  DateTime // วัน-เวลาไป
  endDateTime    DateTime // วัน-เวลากลับ
  pickupLocation String? // จุดที่ขอให้รถออกจาก (ที่จอดรถคณะฯ/สำนักงานอธิการบดี/อื่น ๆ)
  tripType       TripType @default(ROUND_TRIP)

  speakerName  String? // ชื่อวิทยากร (กรณีรับ-ส่งวิทยากร)
  speakerPhone String? // เบอร์โทรศัพท์วิทยากร

  controllerName  String? // ผู้ควบคุมการไปราชการ
  controllerPhone String?

  budgetSource String? // แหล่งเบิกจ่ายงบประมาณ

  status       BookingStatus @default(PENDING)
  rejectReason String?

  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])
  vehicleId Int?

  driver   Driver? @relation(fields: [driverId], references: [id])
  driverId Int?

  approvedById Int? // id ของ staff ที่อนุมัติ/ปฏิเสธ

  passengers Passenger[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("bookings")
}

// ==========================
// รายชื่อผู้ร่วมเดินทาง (สูงสุดไม่เกิน 10 คนต่อคัน)
// ==========================
model Passenger {
  id        Int     @id @default(autoincrement())
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId Int
  name      String

  @@map("passengers")
}
